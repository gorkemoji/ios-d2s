 	gpu_ready = true;
 	printf("D2S GPU: ready (kernel page %u bytes)\n", (unsigned)PAGE_SIZE);
+	if (!q_start()) {
+		printf("D2S GPU: no job worker thread, async submit off\n");
+		q_lock = NULL;
+	}
 	if (test) {
 		self_test();
 	}
