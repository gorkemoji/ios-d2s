+/* ---- asynchronous jobs ----------------------------------------------- */
+
+/*
+ * One FIFO for every context; a worker thread runs the jobs in submission
+ * order, one at a time, so a job never starts before an earlier one (of any
+ * context) has finished. That is stricter than panfrost's dependencies, and
+ * simple. Each job gets a sequence number; results of the last QLEN jobs
+ * are kept by number for d2s_gpu_wait.
+ */
+#define QLEN		64
+#define JOB_TIMEOUT_US	2000000
+
+struct qjob {
+	struct d2s_gpu_ctx *c;
+	int js;
+	uint64_t head, seq;
+};
+
+struct qdone {
+	uint64_t seq;
+	int rc;
+	struct d2s_gpu_result r;
+};
+
+static lck_mtx_t *q_lock;
+static struct qjob q[QLEN];
+static struct qdone qdone[QLEN];
+static uint64_t submit_seq, done_seq;	/* under q_lock */
+
+static void
+q_worker(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		lck_mtx_lock(q_lock);
+		while (done_seq == submit_seq) {
+			(void)lck_mtx_sleep(q_lock, LCK_SLEEP_DEFAULT, (event_t)&submit_seq, THREAD_UNINT);
+		}
+		struct qjob j = q[(done_seq + 1) % QLEN];
+		lck_mtx_unlock(q_lock);
+
+		struct d2s_gpu_result r;
+		int rc = d2s_gpu_run(j.c, j.js, j.head, JOB_TIMEOUT_US, &r);
+		if (rc != D2S_GPU_JOB_DONE) {
+			printf("D2S GPU: job %llu (AS%d) rc %d js status %#x fault %#x @ %#llx\n",
+			    j.seq, j.c->as, rc, r.js_status, r.fault_status, r.fault_addr);
+		}
+
+		lck_mtx_lock(q_lock);
+		struct qdone *d = &qdone[j.seq % QLEN];
+		d->seq = j.seq;
+		d->rc = rc;
+		d->r = r;
+		done_seq = j.seq;
+		thread_wakeup((event_t)&done_seq);
+		lck_mtx_unlock(q_lock);
+	}
+}
+
+/* Queue a job chain; *seq gets its number. Blocks while the queue is full. */
+int
+d2s_gpu_submit(struct d2s_gpu_ctx *c, int js, uint64_t head, uint64_t *seq)
+{
+	if (!gpu_ready || q_lock == NULL || c->as < 0 || js < 0 || js > 2 ||
+	    !(info.js_present & (1u << js))) {
+		return D2S_GPU_JOB_INVALID;
+	}
+	lck_mtx_lock(q_lock);
+	while (submit_seq - done_seq >= QLEN - 1) {
+		(void)lck_mtx_sleep(q_lock, LCK_SLEEP_DEFAULT, (event_t)&done_seq, THREAD_UNINT);
+	}
+	uint64_t s = ++submit_seq;
+	q[s % QLEN] = (struct qjob){ c, js, head, s };
+	c->last_seq = s;
+	thread_wakeup((event_t)&submit_seq);
+	lck_mtx_unlock(q_lock);
+	*seq = s;
+	return D2S_GPU_JOB_DONE;
+}
+
+/*
+ * Wait up to timeout_us (0: just look) for job seq. Returns its D2S_GPU_JOB_*
+ * result (DONE for a job too old to still have one), or TIMEOUT if it has
+ * not finished; r (may be NULL) gets its registers.
+ */
+int
+d2s_gpu_wait(uint64_t seq, uint32_t timeout_us, struct d2s_gpu_result *r)
+{
+	if (r != NULL) {
+		bzero(r, sizeof(*r));
+	}
+	if (q_lock == NULL || seq == 0) {
+		return D2S_GPU_JOB_DONE;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(timeout_us, NSEC_PER_USEC, &deadline);
+	lck_mtx_lock(q_lock);
+	if (seq > submit_seq) {
+		lck_mtx_unlock(q_lock);
+		return D2S_GPU_JOB_INVALID;
+	}
+	while (done_seq < seq) {
+		if (timeout_us == 0 || mach_absolute_time() >= deadline) {
+			lck_mtx_unlock(q_lock);
+			return D2S_GPU_JOB_TIMEOUT;
+		}
+		(void)lck_mtx_sleep_deadline(q_lock, LCK_SLEEP_DEFAULT, (event_t)&done_seq,
+		    THREAD_UNINT, deadline);
+	}
+	int rc = D2S_GPU_JOB_DONE;
+	struct qdone *d = &qdone[seq % QLEN];
+	if (d->seq == seq) {
+		rc = d->rc;
+		if (r != NULL) {
+			*r = d->r;
+		}
+	}
+	lck_mtx_unlock(q_lock);
+	return rc;
+}
+
+/* Number of the newest finished job. */
+uint64_t
+d2s_gpu_done_seq(void)
+{
+	return done_seq;
+}
+
+static bool
+q_start(void)
+{
+	q_lock = lck_mtx_alloc_init(gpu_lck_grp, LCK_ATTR_NULL);
+	thread_t th;
+	if (kernel_thread_start(q_worker, NULL, &th) != KERN_SUCCESS) {
+		return false;
+	}
+	thread_deallocate(th);
+	return true;
+}
