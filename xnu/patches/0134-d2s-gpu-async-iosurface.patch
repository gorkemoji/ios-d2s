+int
+D2SGPUSpace::submitAsync(int js, uint64_t head, const uint32_t *handles, uint32_t n,
+    uint64_t *seq)
+{
+	if (!ready) {
+		return D2S_GPU_JOB_INVALID;
+	}
+	IOLockLock(lock);
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t h = handles[i];
+		if (h >= 1 && h <= MAX_BUFS && bufs[h - 1].md != NULL && bufs[h - 1].kva != 0) {
+			d2s_gpu_flush(bufs[h - 1].kva, bufs[h - 1].size);
+		}
+	}
+	int rc = d2s_gpu_submit(&ctx, js, head, seq);
+	if (rc == D2S_GPU_JOB_DONE) {
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t h = handles[i];
+			if (h >= 1 && h <= MAX_BUFS && bufs[h - 1].md != NULL) {
+				bufs[h - 1].last_seq = *seq;
+			}
+		}
+	}
+	IOLockUnlock(lock);
+	return rc;
+}
+
+int
+D2SGPUSpace::waitBuf(uint32_t handle, uint32_t timeout_us)
+{
+	if (handle < 1 || handle > MAX_BUFS) {
+		return D2S_GPU_JOB_INVALID;
+	}
+	IOLockLock(lock);
+	bool present = bufs[handle - 1].md != NULL;
+	uint64_t seq = bufs[handle - 1].last_seq;
+	IOLockUnlock(lock);
+	if (!present) {
+		return D2S_GPU_JOB_INVALID;
+	}
+	int rc = d2s_gpu_wait(seq, timeout_us, NULL);
+	if (rc != D2S_GPU_JOB_TIMEOUT) {
+		IOLockLock(lock);
+		if (bufs[handle - 1].md != NULL && bufs[handle - 1].kva != 0) {
+			d2s_gpu_flush(bufs[handle - 1].kva, bufs[handle - 1].size);
+		}
+		IOLockUnlock(lock);
+	}
+	return rc;
+}
