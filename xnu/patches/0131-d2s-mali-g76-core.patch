+/*
+ * Galaxy Note 10+ (d2s) Mali-G76 kernel driver core (bsd/dev/d2s_gpu.c).
+ * Used by the boot self-test now and by the user client in GPU step 3b.
+ */
+#ifndef _D2S_GPU_H_
+#define _D2S_GPU_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+
+struct d2s_gpu_info {
+	uint32_t gpu_id;
+	uint32_t mmu_features;
+	uint32_t as_present;
+	uint32_t js_present;
+	uint64_t shader_present;
+	uint32_t tiler_present;
+	uint32_t l2_present;
+};
+
+struct d2s_gpu_mem {
+	vm_offset_t va;		/* kernel address */
+	uint64_t pa;
+	uint32_t size;
+};
+
+struct d2s_gpu_ctx {
+	int as;			/* hardware address space 0-7 */
+	bool bound;		/* tables loaded into the address space */
+	struct d2s_gpu_mem l0;
+};
+
+struct d2s_gpu_result {
+	uint32_t us;
+	uint32_t job_rawstat;
+	uint32_t js_status;
+	uint64_t js_head;
+	uint32_t mmu_rawstat;
+	uint32_t fault_status;
+	uint64_t fault_addr;
+	bool reset_ok;
+};
+
+#define D2S_GPU_MAP_WRITE	1u
+#define D2S_GPU_MAP_EXEC	2u
+
+#define D2S_GPU_JOB_DONE	0
+#define D2S_GPU_JOB_ERROR	1
+#define D2S_GPU_JOB_MMU_FAULT	2
+#define D2S_GPU_JOB_TIMEOUT	3
+#define D2S_GPU_JOB_INVALID	4
+
+const struct d2s_gpu_info *d2s_gpu_get_info(void);
+bool d2s_gpu_alloc(uint32_t size, struct d2s_gpu_mem *m);
+void d2s_gpu_sync(uint64_t pa, uint32_t len, bool to_gpu);
+bool d2s_gpu_ctx_init(struct d2s_gpu_ctx *c, int as);
+bool d2s_gpu_map(struct d2s_gpu_ctx *c, uint64_t va, uint64_t pa, uint64_t size, uint32_t flags);
+bool d2s_gpu_ctx_bind(struct d2s_gpu_ctx *c);
+int d2s_gpu_run(struct d2s_gpu_ctx *c, int js, uint64_t head, uint32_t timeout_us,
+    struct d2s_gpu_result *r);
+
+#endif
