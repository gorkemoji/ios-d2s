diff --git a/bsd/dev/d2s_gpu.c b/bsd/dev/d2s_gpu.c
index 961aca5..a697ac9 100644
--- a/bsd/dev/d2s_gpu.c
+++ b/bsd/dev/d2s_gpu.c
@@ -618,6 +618,21 @@ d2s_gpu_get_info(void)
 	return gpu_ready ? &info : NULL;
 }
 
+/*
+ * Read one register of the GPU control page (offset < 0x1000, 4-byte
+ * aligned): the ID and feature registers Mesa asks for through panfrost's
+ * GET_PARAM. Reads have no side effects there. Returns false otherwise.
+ */
+bool
+d2s_gpu_read_reg(uint32_t off, uint32_t *val)
+{
+	if (!gpu_ready || off >= 0x1000 || (off & 3)) {
+		return false;
+	}
+	*val = gr(off);
+	return true;
+}
