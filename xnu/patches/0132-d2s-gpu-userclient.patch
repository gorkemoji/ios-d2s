diff --git a/iokit/Kernel/arm/D2SGPU.cpp b/iokit/Kernel/arm/D2SGPU.cpp
new file mode 100644
index 0000000..5e91b2f
--- /dev/null
+++ b/iokit/Kernel/arm/D2SGPU.cpp
@@ -0,0 +1,536 @@
+/*
+ * Galaxy Note 10+ (d2s): user-space interface to the Mali-G76 driver core
+ * (bsd/dev/d2s_gpu.c). GPU step 3b.
+ *
+ * IOServiceOpen(IOServiceMatching("D2SGPU"), mach_task_self(), 0, &conn)
+ * gives a process its own GPU context: a hardware address space and page
+ * tables. Buffers are wired kernel memory mapped into that GPU address
+ * space and, with IOConnectMapMemory64(conn, handle, ...), into the
+ * process. Selectors (IOConnectCall*Method):
+ *
+ *   0 GET_INFO      struct out  struct d2s_gpu_uinfo
+ *   1 BUF_CREATE    in  size, flags (1 GPU write, 2 GPU exec)
+ *                   out handle, GPU address, size (4 KiB multiple)
+ *   2 BUF_DESTROY   in  handle (process mappings keep the memory alive)
+ *   3 SUBMIT        in  job slot, GPU address of the first job, timeout us
+ *                   out rc (0 done, 1 job error, 2 MMU fault, 3 timeout,
+ *                   4 invalid), us, JS status, fault status, fault
+ *                   address, reset ok
+ *   4 LOG           struct in  text, written to the kernel log
+ *
+ * SUBMIT is synchronous (completion is polled; no interrupts yet) and
+ * writes back and invalidates every buffer of the context around the job,
+ * since the GPU does not snoop CPU caches. GPU addresses come from
+ * [32 MiB, 4 GiB) with a guard page between buffers, like Linux panfrost.
+ *
+ * At boot, a thread runs the same buffer and submit path once from the
+ * kernel and logs "D2S GPU UC: BOOT TEST ...".
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(D2S)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+#include "../../../bsd/dev/d2s_gpu.h"
+
+#define GPAGE		4096u
+#define VA_START	(32ull << 20)
+#define VA_END		(4ull << 30)
+#define MAX_BUFS	1024u
+#define MAX_BUF_SIZE	(256u << 20)
+
+/* GET_INFO payload; same layout in user space (tools/d2s-gpu/d2sgpu.h) */
+struct d2s_gpu_uinfo {
+	uint32_t version;		/* 1 */
+	uint32_t gpu_id;
+	uint32_t mmu_features;
+	uint32_t as_present;
+	uint32_t js_present;
+	uint32_t tiler_present;
+	uint32_t l2_present;
+	uint32_t as;			/* this connection's address space */
+	uint64_t shader_present;
+};
+
+/* ---- one GPU address space with its buffers ------------------------- */
+
+struct D2SGPUBuf {
+	IOBufferMemoryDescriptor *md;	/* NULL = free slot */
+	uint64_t gva;
+	uint32_t size;
+	uint32_t flags;
+};
+
+class D2SGPUSpace {
+public:
+	bool init(void);
+	void destroy(void);
+	IOReturn create(uint64_t size, uint32_t flags, uint32_t *handle, uint64_t *gva,
+	    uint64_t *out_size);
+	IOReturn destroyBuf(uint32_t handle);
+	IOBufferMemoryDescriptor *buffer(uint32_t handle);	/* retained */
+	int submit(int js, uint64_t head, uint32_t timeout_us, struct d2s_gpu_result *r);
+	int as(void) const { return ctx.as; }
+
+private:
+	uint64_t findVA(uint64_t size);
+	void flushAll(void);
+
+	IOLock *lock;
+	struct d2s_gpu_ctx ctx;
+	D2SGPUBuf *bufs;
+	bool ready;
+};
+
+bool
+D2SGPUSpace::init(void)
+{
+	ready = false;
+	bufs = NULL;
+	lock = IOLockAlloc();
+	if (lock == NULL) {
+		return false;
+	}
+	bufs = IONewZero(D2SGPUBuf, MAX_BUFS);
+	if (bufs == NULL || !d2s_gpu_ctx_init(&ctx)) {
+		destroy();
+		return false;
+	}
+	ready = true;
+	return true;
+}
+
+void
+D2SGPUSpace::destroy(void)
+{
+	if (bufs != NULL) {
+		for (uint32_t i = 0; i < MAX_BUFS; i++) {
+			if (bufs[i].md != NULL) {
+				(void)destroyBuf(i + 1);
+			}
+		}
+		IODelete(bufs, D2SGPUBuf, MAX_BUFS);
+		bufs = NULL;
+	}
+	if (ready) {
+		d2s_gpu_ctx_destroy(&ctx);
+		ready = false;
+	}
+	if (lock != NULL) {
+		IOLockFree(lock);
+		lock = NULL;
+	}
+}
+
+/* First fit in [VA_START, VA_END) with a guard page after every buffer;
+ * lock held. */
+uint64_t
+D2SGPUSpace::findVA(uint64_t size)
+{
+	uint64_t cand = VA_START;
+	bool moved = true;
+	while (moved) {
+		moved = false;
+		if (cand + size > VA_END) {
+			return 0;
+		}
+		for (uint32_t i = 0; i < MAX_BUFS; i++) {
+			if (bufs[i].md == NULL) {
+				continue;
+			}
+			uint64_t lo = bufs[i].gva, hi = lo + bufs[i].size + GPAGE;
+			if (cand < hi && lo < cand + size + GPAGE) {
+				cand = hi;
+				moved = true;
+			}
+		}
+	}
+	return cand;
+}
+
+IOReturn
+D2SGPUSpace::create(uint64_t size, uint32_t flags, uint32_t *handle, uint64_t *gva,
+    uint64_t *out_size)
+{
+	if (!ready || size == 0 || size > MAX_BUF_SIZE || (flags & ~3u)) {
+		return kIOReturnBadArgument;
+	}
+	/* whole kernel pages: a process maps whole pages, so nothing else may
+	 * share the last one */
+	size = (size + PAGE_SIZE - 1) & ~(uint64_t)(PAGE_SIZE - 1);
+	IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(
+		kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, size, PAGE_SIZE);
+	if (md == NULL) {
+		return kIOReturnNoMemory;
+	}
+	uint32_t npages = (uint32_t)(size / GPAGE);
+	uint64_t *pas = IONew(uint64_t, npages);
+	if (pas == NULL) {
+		md->release();
+		return kIOReturnNoMemory;
+	}
+	for (uint32_t i = 0; i < npages; i++) {
+		IOByteCount len = 0;
+		pas[i] = md->getPhysicalSegment((IOByteCount)i * GPAGE, &len, kIOMemoryMapperNone);
+	}
+	bzero(md->getBytesNoCopy(), size);
+	d2s_gpu_flush((vm_offset_t)md->getBytesNoCopy(), (uint32_t)size);
+
+	IOReturn ret = kIOReturnNoSpace;
+	IOLockLock(lock);
+	uint32_t slot = MAX_BUFS;
+	for (uint32_t i = 0; i < MAX_BUFS; i++) {
+		if (bufs[i].md == NULL) {
+			slot = i;
+			break;
+		}
+	}
+	uint64_t va = slot < MAX_BUFS ? findVA(size) : 0;
+	if (va != 0) {
+		if (d2s_gpu_map_pages(&ctx, va, pas, npages, flags)) {
+			bufs[slot].md = md;
+			bufs[slot].gva = va;
+			bufs[slot].size = (uint32_t)size;
+			bufs[slot].flags = flags;
+			*handle = slot + 1;
+			*gva = va;
+			*out_size = size;
+			md = NULL;
+			ret = kIOReturnSuccess;
+		} else {
+			d2s_gpu_unmap(&ctx, va, size);
+			ret = kIOReturnNoMemory;
+		}
+	}
+	IOLockUnlock(lock);
+	IODelete(pas, uint64_t, npages);
+	if (md != NULL) {
+		md->release();
+	}
+	return ret;
+}
+
+IOReturn
+D2SGPUSpace::destroyBuf(uint32_t handle)
+{
+	IOBufferMemoryDescriptor *md = NULL;
+	IOLockLock(lock);
+	if (handle >= 1 && handle <= MAX_BUFS && bufs[handle - 1].md != NULL) {
+		D2SGPUBuf *b = &bufs[handle - 1];
+		d2s_gpu_unmap(&ctx, b->gva, b->size);
+		md = b->md;
+		bzero(b, sizeof(*b));
+	}
+	IOLockUnlock(lock);
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	md->release();
+	return kIOReturnSuccess;
+}
+
+IOBufferMemoryDescriptor *
+D2SGPUSpace::buffer(uint32_t handle)
+{
+	IOBufferMemoryDescriptor *md = NULL;
+	IOLockLock(lock);
+	if (handle >= 1 && handle <= MAX_BUFS && bufs[handle - 1].md != NULL) {
+		md = bufs[handle - 1].md;
+		md->retain();
+	}
+	IOLockUnlock(lock);
+	return md;
+}
+
+/* lock held */
+void
+D2SGPUSpace::flushAll(void)
+{
+	for (uint32_t i = 0; i < MAX_BUFS; i++) {
+		if (bufs[i].md != NULL) {
+			d2s_gpu_flush((vm_offset_t)bufs[i].md->getBytesNoCopy(), bufs[i].size);
+		}
+	}
+}
+
+int
+D2SGPUSpace::submit(int js, uint64_t head, uint32_t timeout_us, struct d2s_gpu_result *r)
+{
+	if (!ready) {
+		bzero(r, sizeof(*r));
+		return D2S_GPU_JOB_INVALID;
+	}
+	if (timeout_us == 0 || timeout_us > 2000000) {
+		timeout_us = 2000000;
+	}
+	IOLockLock(lock);
+	flushAll();
+	int rc = d2s_gpu_run(&ctx, js, head, timeout_us, r);
+	flushAll();
+	IOLockUnlock(lock);
+	return rc;
+}
+
+/* ---- the service ----------------------------------------------------- */
+
+class D2SGPU : public IOService {
+	OSDeclareDefaultStructors(D2SGPU);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+
+private:
+	static void bootTest(void *arg, wait_result_t wr);
+};
+
+OSDefineMetaClassAndStructors(D2SGPU, IOService);
+
+bool
+D2SGPU::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "D2SGPUUserClient");
+	registerService();
+	IOLog("D2S GPU UC: D2SGPU registered\n");
+
+	int test = 1;
+	(void)PE_parse_boot_argn("d2sgpu", &test, sizeof(test));
+	thread_t th;
+	if (test && kernel_thread_start(&D2SGPU::bootTest, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	return true;
+}
+
+static void
+uc_write_value_job(uint32_t *j, uint64_t dst, uint32_t value)
+{
+	bzero(j, 64);
+	j[4] = 1u | 2u << 1 | 1u << 16;		/* is64b, Write Value, index 1 */
+	j[8] = (uint32_t)dst;
+	j[9] = (uint32_t)(dst >> 32);
+	j[10] = 6;				/* Immediate 32 */
+	j[12] = value;
+}
+
+/* The user-client path, driven from the kernel once the GPU is up. */
+void
+D2SGPU::bootTest(__unused void *arg, __unused wait_result_t wr)
+{
+	for (int i = 0; i < 600 && d2s_gpu_get_info() == NULL; i++) {
+		IOSleep(100);
+	}
+	if (d2s_gpu_get_info() == NULL) {
+		IOLog("D2S GPU UC: BOOT TEST skipped, GPU not up after 60 s\n");
+		return;
+	}
+	D2SGPUSpace s;
+	uint32_t hjob = 0, hres = 0, hres2 = 0;
+	uint64_t gjob = 0, gres = 0, gres2 = 0, sz = 0;
+	struct d2s_gpu_result r;
+	bool ok = false, reuse = false;
+	int rc = -1;
+	if (!s.init()) {
+		IOLog("D2S GPU UC: BOOT TEST FAIL, no context\n");
+	} else if (s.create(GPAGE, 1, &hjob, &gjob, &sz) != kIOReturnSuccess ||
+	    s.create(64 * 1024, 1, &hres, &gres, &sz) != kIOReturnSuccess) {
+		IOLog("D2S GPU UC: BOOT TEST FAIL, buffer create\n");
+	} else {
+		IOBufferMemoryDescriptor *jm = s.buffer(hjob), *rm = s.buffer(hres);
+		uint32_t *job = (uint32_t *)jm->getBytesNoCopy();
+		volatile uint32_t *res = (volatile uint32_t *)rm->getBytesNoCopy();
+		/* last page of a 16-page buffer: crosses kernel pages if they are 4 KiB */
+		uc_write_value_job(job, gres + 60 * 1024, 0xD25B0001u);
+		res[60 * 1024 / 4] = 0x33333333u;
+		rc = s.submit(0, gjob, 100000, &r);
+		ok = rc == D2S_GPU_JOB_DONE && res[60 * 1024 / 4] == 0xD25B0001u;
+		IOLog("D2S GPU UC: job rc %d in %u us, result %#x, AS%d, job %#llx res %#llx\n",
+		    rc, r.us, res[60 * 1024 / 4], s.as(), gjob, gres);
+		jm->release();
+		rm->release();
+		/* a freed range is found again */
+		reuse = s.destroyBuf(hres) == kIOReturnSuccess &&
+		    s.create(64 * 1024, 1, &hres2, &gres2, &sz) == kIOReturnSuccess && gres2 == gres;
+	}
+	int as = s.as();
+	s.destroy();
+	IOLog("D2S GPU UC: BOOT TEST %s (job %s, VA reuse %s, AS%d released)\n",
+	    ok && reuse ? "OK" : "FAIL", ok ? "ok" : "FAIL", reuse ? "ok" : "FAIL", as);
+}
+
+/* ---- the user client ------------------------------------------------- */
+
+class D2SGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(D2SGPUUserClient);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientDied(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+
+private:
+	D2SGPUSpace *space;
+	char name[32];
+};
+
+OSDefineMetaClassAndStructors(D2SGPUUserClient, IOUserClient);
+
+bool
+D2SGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	space = NULL;
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	proc_selfname(name, sizeof(name));
+	if (d2s_gpu_get_info() == NULL) {
+		IOLog("D2S GPU UC: %s: open refused, GPU not up\n", name);
+		return false;
+	}
+	space = IONew(D2SGPUSpace, 1);
+	if (space == NULL || !space->init()) {
+		IOLog("D2S GPU UC: %s: open refused, no free address space\n", name);
+		if (space != NULL) {
+			IODelete(space, D2SGPUSpace, 1);
+			space = NULL;
+		}
+		return false;
+	}
+	IOLog("D2S GPU UC: %s: open, AS%d\n", name, space->as());
+	return true;
+}
+
+void
+D2SGPUUserClient::free(void)
+{
+	if (space != NULL) {
+		space->destroy();
+		IODelete(space, D2SGPUSpace, 1);
+		space = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+D2SGPUUserClient::clientClose(void)
+{
+	IOLog("D2S GPU UC: %s: close\n", name);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+D2SGPUUserClient::clientDied(void)
+{
+	return clientClose();
+}
+
+/* type = buffer handle; the caller gets a reference */
+IOReturn
+D2SGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options,
+    IOMemoryDescriptor **memory)
+{
+	IOBufferMemoryDescriptor *md = space != NULL ? space->buffer(type) : NULL;
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	*options = 0;
+	*memory = md;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+D2SGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	if (space == NULL) {
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case 0: {	/* GET_INFO */
+		const struct d2s_gpu_info *gi = d2s_gpu_get_info();
+		struct d2s_gpu_uinfo u = {};
+		if (a->structureOutput == NULL || a->structureOutputSize < sizeof(u) || gi == NULL) {
+			return kIOReturnBadArgument;
+		}
+		u.version = 1;
+		u.gpu_id = gi->gpu_id;
+		u.mmu_features = gi->mmu_features;
+		u.as_present = gi->as_present;
+		u.js_present = gi->js_present;
+		u.tiler_present = gi->tiler_present;
+		u.l2_present = gi->l2_present;
+		u.as = (uint32_t)space->as();
+		u.shader_present = gi->shader_present;
+		bcopy(&u, a->structureOutput, sizeof(u));
+		a->structureOutputSize = sizeof(u);
+		return kIOReturnSuccess;
+	}
+	case 1: {	/* BUF_CREATE */
+		if (a->scalarInputCount != 2 || a->scalarOutputCount != 3) {
+			return kIOReturnBadArgument;
+		}
+		uint32_t h = 0;
+		uint64_t va = 0, size = 0;
+		IOReturn ret = space->create(a->scalarInput[0], (uint32_t)a->scalarInput[1], &h, &va, &size);
+		a->scalarOutput[0] = h;
+		a->scalarOutput[1] = va;
+		a->scalarOutput[2] = size;
+		return ret;
+	}
+	case 2:		/* BUF_DESTROY */
+		if (a->scalarInputCount != 1) {
+			return kIOReturnBadArgument;
+		}
+		return space->destroyBuf((uint32_t)a->scalarInput[0]);
+	case 3: {	/* SUBMIT */
+		if (a->scalarInputCount != 3 || a->scalarOutputCount != 6) {
+			return kIOReturnBadArgument;
+		}
+		struct d2s_gpu_result r;
+		int rc = space->submit((int)a->scalarInput[0], a->scalarInput[1],
+		    (uint32_t)a->scalarInput[2], &r);
+		a->scalarOutput[0] = (uint64_t)rc;
+		a->scalarOutput[1] = r.us;
+		a->scalarOutput[2] = r.js_status;
+		a->scalarOutput[3] = r.fault_status;
+		a->scalarOutput[4] = r.fault_addr;
+		a->scalarOutput[5] = r.reset_ok;
+		if (rc != D2S_GPU_JOB_DONE) {
+			IOLog("D2S GPU UC: %s: job rc %d js status %#x fault %#x @ %#llx\n",
+			    name, rc, r.js_status, r.fault_status, r.fault_addr);
+		}
+		return kIOReturnSuccess;
+	}
+	case 4: {	/* LOG */
+		char text[160];
+		uint32_t n = a->structureInputSize < sizeof(text) - 1 ?
+		    a->structureInputSize : (uint32_t)sizeof(text) - 1;
+		if (a->structureInput == NULL) {
+			return kIOReturnBadArgument;
+		}
+		bcopy(a->structureInput, text, n);
+		text[n] = 0;
+		IOLog("D2S GPU UC: %s: %s\n", name, text);
+		return kIOReturnSuccess;
+	}
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+#endif /* D2S */
