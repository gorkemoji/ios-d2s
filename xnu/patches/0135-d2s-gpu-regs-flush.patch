+/* Write back and drop a buffer's cache lines now, without waiting. */
+IOReturn
+D2SGPUSpace::flushBuf(uint32_t handle)
+{
+	if (handle < 1 || handle > MAX_BUFS) {
+		return kIOReturnBadArgument;
+	}
+	IOReturn ret = kIOReturnBadArgument;
+	IOLockLock(lock);
+	if (bufs[handle - 1].md != NULL) {
+		if (bufs[handle - 1].kva != 0) {
+			d2s_gpu_flush(bufs[handle - 1].kva, bufs[handle - 1].size);
+		}
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(lock);
+	return ret;
+}
