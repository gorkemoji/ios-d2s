diff --git a/bsd/dev/a5xelte_touch.c b/bsd/dev/a5xelte_touch.c
index eb86b77..6cc1fd9 100644
--- a/bsd/dev/a5xelte_touch.c
+++ b/bsd/dev/a5xelte_touch.c
@@ -668,6 +668,108 @@ static int s8ts_native;         /* sweetfb_native: iOS sees the whole panel */
 static bool s8ts_down[S8TS_FINGERS];
 static uint16_t s8ts_x[S8TS_FINGERS], s8ts_y[S8TS_FINGERS];
 
+#if defined(D2S)
+/*
+ * Exynos 9820 HSI2C, as Samsung's 9820 i2c-exynos5.c. The SCL-high and
+ * start-hold timing fields are bit masks there, not the cycle counts of the
+ * 8895/mainline driver below; stock Android logs FS1 0x01f0ff00,
+ * FS2 0x030003e0, FS3 0x00210000 for this bus at 200 MHz. The loader runs
+ * the USI clock from OSCCLK, so at 26 MHz: div 4, SCL-high 0xf0,
+ * start-hold 0xf8. hsi2c_10 has samsung,stop-after-trans (STOP after every
+ * message) and samsung,scl-clk-stretching (wait for master state INIT).
+ */
+static void
+s8i2c_reset(vm_offset_t bus)
+{
+	unsigned div = (S8_I2C_CLKIN / (S8_I2C_SCL_HZ * 15)) & 0xff;
+	unsigned n = (9 * (S8_I2C_CLKIN / 1000000)) / ((div + 1) * 10);
+	a5touch_write(bus, 0x00, a5touch_read(bus, 0x00) | (1u << 31));
+	a5touch_write(bus, 0x00, a5touch_read(bus, 0x00) & ~(1u << 31));
+	a5touch_write(bus, 0x60, 0x0100ff00u | ((0xffffffffu >> (n - 1) << (n - 1)) & 0xff) << 16);
+	a5touch_write(bus, 0x64, 0x03000300u | ((0xffffffffu >> n << n) & 0xff));
+	a5touch_write(bus, 0x68, div << 16);
+	a5touch_write(bus, 0x00, 1u << 3);
+	a5touch_write(bus, 0x08, 0xffffff);
+	a5touch_write(bus, 0x40, a5touch_read(bus, 0x40) | (1u << 31));
+}
+
+static unsigned s8i2c_fails;
+
+static bool
+s8i2c_fail(vm_offset_t bus, unsigned why)
+{
+	if (++s8i2c_fails <= 8) {
+		printf("S8 TOUCH: i2c fail %#x int %#x trans %#x fifo %#x\n", why,
+		    a5touch_read(bus, 0x24), a5touch_read(bus, 0x50), a5touch_read(bus, 0x30));
+	}
+	return false;
+}
+
+/* One message, polled, as exynos5_i2c_xfer_msg with stop-after-trans. */
+static bool
+s8i2c_msg(vm_offset_t bus, unsigned addr, bool rd, uint8_t *buf, unsigned len)
+{
+	uint32_t ctl = a5touch_read(bus, 0x00) & ~0xc0u;
+	uint32_t ac = a5touch_read(bus, 0x44) & ~(0xffffu | (1u << 16) | (1u << 31));
+	unsigned trig = len < 8 ? len : 8;
+	unsigned i = 0, us;
+	a5touch_write(bus, 0x48, a5touch_read(bus, 0x48) & ~(1u << 31));
+	a5touch_write(bus, 0x04, 3 | trig << 4 | trig << 16);
+	ctl |= rd ? 0x40u : 0x80u;
+	ac |= (rd ? (1u << 16) : 0) | (1u << 17) | len;
+	a5touch_write(bus, 0x24, a5touch_read(bus, 0x24));
+	a5touch_write(bus, 0x70, 7u << 24 | (addr & 0x7f) << 10);
+	a5touch_write(bus, 0x00, ctl);
+	a5touch_write(bus, 0x20, 0xf80u);
+	a5touch_write(bus, 0x44, ac);
+	a5touch_write(bus, 0x44, a5touch_read(bus, 0x44) | (1u << 31));
+	for (us = 0; us < 50000; us++) {
+		uint32_t s = a5touch_read(bus, 0x24);
+		if (s & 0xf00u) {
+			return s8i2c_fail(bus, 1);
+		}
+		if (rd) {
+			while (i < len && !(a5touch_read(bus, 0x30) & (1u << 24))) {
+				buf[i++] = (uint8_t)a5touch_read(bus, 0x38);
+			}
+			if (i == len) {
+				break;
+			}
+		} else {
+			while (i < len && (a5touch_read(bus, 0x30) & 0x7fu) < 64) {
+				a5touch_write(bus, 0x34, buf[i++]);
+			}
+			if (i == len && (s & 0x80u) && (a5touch_read(bus, 0x30) & (1u << 8))) {
+				a5touch_write(bus, 0x24, s);
+				break;
+			}
+		}
+		delay(1);
+	}
+	if (us == 50000) {
+		return s8i2c_fail(bus, rd ? 0x100 | i : 3);
+	}
+	for (us = 0; (a5touch_read(bus, 0x50) & 0xfu) != 1; us++) {
+		if (us == 100000) {
+			return s8i2c_fail(bus, 4);
+		}
+		delay(1);
+	}
+	return true;
+}
+
+static bool
+s8i2c_xfer(vm_offset_t bus, unsigned addr, const uint8_t *w, unsigned wlen,
+    uint8_t *r, unsigned rlen)
+{
+	if ((wlen && !s8i2c_msg(bus, addr, false, __DECONST(uint8_t *, w), wlen)) ||
+	    (rlen && !s8i2c_msg(bus, addr, true, r, rlen))) {
+		s8i2c_reset(bus);
+		return false;
+	}
+	return true;
+}
+#else
 /* i2c-exynos5.c: reset, Exynos8895 fast-mode timing, master auto mode. */
 static void
 s8i2c_reset(vm_offset_t bus)
@@ -750,6 +852,7 @@ fail:
 	s8i2c_reset(bus);
 	return false;
 }
+#endif /* D2S */
 
 static bool
 s8ts_cmd_read(uint8_t cmd, uint8_t *r, unsigned rlen)
